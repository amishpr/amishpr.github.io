{
  // docs/ is the built site. It is regenerated by `npm run build`, so editing it by hand would be lost.
  "files.readonlyInclude": { "docs/**": true },
  "search.exclude": { "docs/**": true, "CLEAN-UP/**": true, "package-lock.json": true },
  "files.watcherExclude": { "docs/**": true, "CLEAN-UP/**": true, ".ssr/**": true },

  "editor.tabSize": 2,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Code Spell Checker: names and terms in content.ts that are spelled correctly.
  "cSpell.words": [
    "Advisr", "amishpr", "amishprajapati", "Fontsource", "Geofenced", "Netlify", "njoit", "PSECU",
    "Prajapati", "Probus", "Robobot", "Stormlight", "Syntagma", "TomEE", "VWAP", "WebdriverIO"
  ]
}
